# Supabase Configuration
# Public-by-design (protected by RLS) — safe to bundle into the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Test-only — never prefix with EXPO_PUBLIC_ (would bundle it into the client app).
# Used by the integration/contract test suite (tests/helpers/env.ts) to create/inspect
# users directly. Get it from the project's API settings.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# RevenueCat Configuration
# Public-by-design (protected server-side by RevenueCat, same trust model as the
# Supabase anon key above) — never put the secret REST API key here.
EXPO_PUBLIC_REVENUECAT_API_KEY=your-revenuecat-public-key-here
